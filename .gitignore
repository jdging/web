# >>> orquestador-claude-codex >>>
# Evidencia local: prompts, threads, eventos y resultados de cada corrida.
.orchestration/

# Versionar solo los agentes y el skill compartido; conservar el resto como configuración local.
!.claude/
.claude/*
!.claude/agents/
!.claude/agents/*.md
!.claude/skills/
.claude/skills/*
!.claude/skills/orchestrating-development/
!.claude/skills/orchestrating-development/**
# Skill de UI/UX acoplado al orquestador (symlink a .agents/skills/): sin esto, en otra
# maquina el skill no se levanta junto al orquestador.
!.claude/skills/front-end-developer

!.codex/
.codex/*
!.codex/agents/
!.codex/agents/*.toml
# <<< orquestador-claude-codex <<<

# Datos de CV: contienen datos personales y de clientes. Repo publico: NO versionar.
ref/
