{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["COMPLETED", "BLOCKED", "FAILED"]
    },
    "summary": { "type": "string" },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"] },
          "evidence": { "type": "string" }
        },
        "required": ["command", "status", "evidence"]
      }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "qa_notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["verdict", "summary", "files_changed", "tests", "risks", "qa_notes"]
}
