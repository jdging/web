{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["COMPLETED", "BLOCKED", "FAILED"]
    },
    "summary": { "type": "string" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_RUN", "PROD_ONLY"] },
          "evidence": { "type": "string" }
        },
        "required": ["command", "status", "evidence"]
      }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "manual_qa": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["verdict", "summary", "checks", "risks", "manual_qa"]
}
